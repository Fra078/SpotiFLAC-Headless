            "title": "External Url",
            "default": ""
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "spotify"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": "album"
          },
          "artist": {
            "type": "string",
            "title": "Artist"
          },
          "release_date": {
            "type": "string",
            "title": "Release Date",
            "default": ""
