    "/api/status/health": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Get Health Status",
        "description": "Runs health checks for the requested streaming service providers.",
        "operationId": "get_health_status_api_status_health_get",
        "parameters": [
          {
            "name": "services",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "tidal",
                "qobuz",
                "deezer",
                "apple",
                "soundcloud",
                "spoti"
              ],
              "title": "Services"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HealthResultSchema"
                  },
                  "title": "Response Get Health Status Api Status Health Get"
