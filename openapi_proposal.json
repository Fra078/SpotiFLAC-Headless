              "tidal",
              "qobuz",
              "deezer"
            ]
          },
          "lyrics_providers": {
            "items": {
              "$ref": "#/components/schemas/LyricsProvider"
            },
            "type": "array",
            "title": "Lyrics Providers",
            "default": [
              "spotify",
              "apple",
              "musixmatch",
              "lrclib",
              "amazon"
            ]
          },
          "filename_format": {
            "type": "string",
            "title": "Filename Format",
            "default": "{title} - {artist}"
          },
          "use_track_numbers": {
            "type": "boolean",
            "title": "Use Track Numbers",
            "default": false
          },
          "use_album_track_numbers": {
            "type": "boolean",
            "title": "Use Album Track Numbers",
            "default": false
          },
          "use_artist_subfolders": {
            "type": "boolean",
            "title": "Use Artist Subfolders",
            "default": false
          },
          "use_album_subfolders": {
            "type": "boolean",
            "title": "Use Album Subfolders",
            "default": false
          },
          "embed_lyrics": {
            "type": "boolean",
            "title": "Embed Lyrics",
            "default": true
          },
          "enrich_metadata": {
            "type": "boolean",
            "title": "Enrich Metadata",
            "default": true
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "AppSettings"
      },
      "ArtistResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "cover": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover",
            "default": ""
          },
          "external_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Url",
            "default": ""
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "spotify"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": "artist"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
