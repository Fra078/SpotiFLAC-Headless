        "type": "string",
        "enum": [
          "LOSSLESS",
          "HIGH",
          "NORMAL"
        ],
        "title": "AudioQuality"
      },
      "DownloadRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir"
          },
          "quality": {
            "type": "string",
            "title": "Quality",
            "default": "LOSSLESS"
          },
          "services": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Services",
            "default": [
              "tidal",
              "qobuz",
              "deezer"
            ]
          },
          "allow_fallback": {
            "type": "boolean",
            "title": "Allow Fallback",
            "default": true
          },
          "filename_format": {
            "type": "string",
            "title": "Filename Format",
            "default": "{title} - {artist}"
          },
          "use_track_numbers": {
            "type": "boolean",
            "title": "Use Track Numbers",
            "default": false
          },
          "use_album_track_numbers": {
            "type": "boolean",
            "title": "Use Album Track Numbers",
            "default": false
          },
          "use_artist_subfolders": {
            "type": "boolean",
            "title": "Use Artist Subfolders",
            "default": false
          },
          "use_album_subfolders": {
            "type": "boolean",
            "title": "Use Album Subfolders",
            "default": false
          },
          "first_artist_only": {
            "type": "boolean",
            "title": "First Artist Only",
            "default": false
          },
          "embed_lyrics": {
            "type": "boolean",
            "title": "Embed Lyrics",
            "default": true
          },
          "lyrics_providers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lyrics Providers",
            "default": [
              "spotify",
              "apple",
              "musixmatch",
              "lrclib",
              "amazon"
            ]
          },
          "enrich_metadata": {
            "type": "boolean",
            "title": "Enrich Metadata",
            "default": true
          },
          "enrich_providers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enrich Providers",
            "default": [
              "deezer",
              "apple",
              "qobuz",
              "tidal",
              "soundcloud"
